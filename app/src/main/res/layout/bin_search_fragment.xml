<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/etBinInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Введите BIN (6–8 цифр)"
        android:textSize="20sp"
        android:inputType="number"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/btnSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Поиск карты"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etBinInput" />

    <ScrollView
        android:id="@+id/resultScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/tvScheme"
                style="@style/ResultText" android:text="Тип карты: "/>

            <TextView android:id="@+id/tvBrand"
                style="@style/ResultText" android:text="Бренд: "/>

            <TextView android:id="@+id/tvType"
                style="@style/ResultText" android:text="Тип: "/>

            <TextView android:id="@+id/tvPrepaid"
                style="@style/ResultText" android:text="Предоплаченная: "/>

            <TextView android:id="@+id/tvCountry"
                style="@style/ResultText" android:text="Страна: "/>

            <TextView android:id="@+id/tvBankName"
                style="@style/ResultText" android:text="Банк: "/>

            <TextView android:id="@+id/tvBankCity"
                style="@style/ResultText" android:text="Город банка: "/>

            <TextView android:id="@+id/tvBankUrl"
                style="@style/ResultText" android:text="Сайт банка:" android:autoLink="web"/>

            <TextView android:id="@+id/tvBankPhone"
                style="@style/ResultText" android:text="Телефон банка:" android:autoLink="phone"/>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Ошибка получения информации с сервера\nПопробуйте ввести другие данные"
        android:textColor="#B00020"
        android:textSize="24sp"
        android:visibility="gone"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSearch" />

</androidx.constraintlayout.widget.ConstraintLayout>